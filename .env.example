NEXT_PUBLIC_SITE_URL=https://reko-med.ru
DATABASE_URL=postgres://rekomed:change-me@postgres:5432/rekomed
POSTGRES_PASSWORD=change-me
PAYLOAD_SECRET=change-me-please
APP_IMAGE=ghcr.io/softaworks/rekomed-app:latest
APP_PORT=3000

LEADS_STORAGE_FILENAME=leads.jsonl
LEAD_RATE_LIMIT_PER_HOUR=12

VK_GROUP_TOKEN=replace-with-vk-group-token
