# Optional temporary fallback for /upload/... if a legacy image was not imported.
# Use an old-origin URL/IP after DNS switch, not https://reko-med.ru itself.
LEGACY_MEDIA_ORIGIN=
LEGACY_MEDIA_HOST_HEADER=
